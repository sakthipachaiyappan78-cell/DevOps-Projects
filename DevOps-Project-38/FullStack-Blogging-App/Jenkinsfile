pipeline {
    agent any

    tools {
        jdk 'jdk17'
        maven 'maven3'
    }

    environment {
        SCANNER_HOME = tool 'sonar-scanner'
    }

    stages {
        stage('Git Checkout') {
            steps {
                git branch: 'main', credentialsId: 'git-cred', url: 'https://github.com/sakthipachaiyappan78-cell/DevOps-Projects.git'
            }
        }

        stage('Build & Test') {
            steps {
                dir('DevOps-Project-38/FullStack-Blogging-App') {
                    sh "mvn clean compile"
                    sh "mvn test"
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                dir('DevOps-Project-38/FullStack-Blogging-App') {
                    withSonarQubeEnv('sonar') {
                        sh """$SCANNER_HOME/bin/sonar-scanner \\
                            -Dsonar.projectKey=twitter-app \\
                            -Dsonar.projectName=twitter-app \\
                            -Dsonar.java.binaries=target/classes"""
                    }
                }
            }
        }

        // ❌ Quality Gate stage removed

        stage('Package & Deploy') {
            steps {
                dir('DevOps-Project-38/FullStack-Blogging-App') {
                    sh "mvn package"
                    withMaven(globalMavenSettingsConfig: 'global-settings', jdk: 'jdk17', maven: 'maven3') {
                        sh "mvn deploy"
                    }
                }
            }
        }

        stage('Docker Build & Scan') {
            steps {
                dir('DevOps-Project-38/FullStack-Blogging-App') {
                    script {
                        withDockerRegistry(credentialsId: 'docker-cred', toolName: 'docker') {
                            sh "docker build -t sakthipachaiyappan78/twitter-app:latest ."
                            sh "trivy image --format table -o trivy-image-report.html sakthipachaiyappan78/twitter-app:latest"
                            sh "docker push sakthipachaiyappan78/twitter-app:latest"
                        }
                    }
                }
            }
        }

        stage('Deploy to Kubernetes') {
            steps {
                dir('DevOps-Project-38/FullStack-Blogging-App') {
                    withKubeConfig(
                        clusterName: 'sakthi',
                        credentialsId: 'k8-cred',
                        namespace: 'webapps',
                        serverUrl: 'https://DE56F67326CC36CDE73CF8B461610E77.gr7.us-east-1.eks.amazonaws.com'
                    ) {
                        sh "kubectl apply -f deployment-service.yml"
                        sh "kubectl get pods -n webapps"
                        sh "kubectl get svc -n webapps"
                    }
                }
            }
        }
    }

    post {
        always {
            emailext (
                subject: "Build ${env.JOB_NAME} #${env.BUILD_NUMBER} - ${currentBuild.currentResult}",
                body: "Build details: ${env.BUILD_URL}",
                to: 'sakthi.p-extgen@hathway.net'
            )
        }
    }
}
